ANTHROPIC_API_KEY=your_api_key_here

# 認証（任意の32文字以上のランダム文字列を設定）
SECRET_KEY=change-me-in-production-use-random-32-chars

# Stripe課金（https://dashboard.stripe.com/test/apikeys から取得）
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price ID（Stripeダッシュボードで月額サブスク商品を作成後に設定）
STRIPE_PRICE_GROWTH=price_xxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxx

# メール通知（任意 — 未設定でも動作します）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=notify_to@example.com
